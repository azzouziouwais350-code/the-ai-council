# THE AI COUNCIL V2.0 — variables d'environnement
# Copier vers .env (ignoré par git) et renseigner les valeurs. Ne jamais committer .env.

# --- Application ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_USER=council
POSTGRES_PASSWORD=change-me
POSTGRES_DB=council
POSTGRES_PORT=5432
DATABASE_URL=postgres://council:change-me@localhost:5432/council

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Fournisseurs IA (uniquement ces quatre) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
