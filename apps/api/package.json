{
  "name": "@council/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "predev": "pnpm --filter @council/shared build",
    "pretest": "pnpm --filter @council/shared build",
    "pretypecheck": "pnpm --filter @council/shared build",
    "prebuild": "pnpm --filter @council/shared build",
    "test:integration": "RUN_INTEGRATION=1 vitest run test/integration.test.ts"
  },
  "dependencies": {
    "@council/shared": "workspace:*",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist"
  ]
}
